      "quality_status": "not_promoted"
    },
    {
      "id": "model_plugin_catalog",
      "path": "src/mmtrainer/models",
      "source_status": "registered",
      "runtime_status": "per_model_gpu_receipt_required",
      "quality_status": "not_promoted"
    },
    {
      "id": "webtrainer_v2_adapter",
      "path": "../webtrainer/rust/fixtures/v3/entrypoint_templates.json",
      "source_status": "cpu_qualified",
      "runtime_status": "disabled",
      "quality_status": "not_applicable"
    }
  ],
  "excluded_artifact_classes": [
    "model_weights",
    "checkpoints",
    "datasets",
    "rollout_images",
    "databases",
    "logs",
    "credentials"
  ]
